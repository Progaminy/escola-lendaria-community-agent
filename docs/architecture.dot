digraph G {
  rankdir=LR;
  graph [bgcolor="white", pad="0.25", nodesep="0.32", ranksep="0.48"];
  node [shape=box, style="rounded", fontname="DejaVu Sans", fontsize=9];
  edge [fontname="DejaVu Sans", fontsize=8];

  supabase [label="Escola Lendária\nSupabase", shape=cylinder];
  adapter [label="Privacy-Minimized\nRead-Only Adapter"];
  platform [label="School / Learning Platform"];
  api [label="FastAPI Event Gateway"];
  events [label="Event Store", shape=cylinder];
  learner [label="Community Operational\nState", shape=cylinder];
  monitor [label="Autonomous\nCommunity Monitor"];
  watch [label="Persistent Risk\nEpisodes", shape=cylinder];
  policy [label="Deterministic\nGuardrail Policy"];
  decisions [label="Signals + Decisions", shape=cylinder];
  queue [label="Human Attention Queue"];
  triage [label="Deterministic Attention Plan\nUrgency + Risk + Waiting"];
  impact [label="Operational Evidence\nSuppression + Clearing + Resolutions"];
  strands [label="Strands Community Agent"];
  bedrock [label="Amazon Bedrock"];
  tools [label="Constrained Tools\nContext • Plan • Evidence • Notes"];
  dash [label="Judge-Focused Dashboard\n+ Audit"];
  human [label="Teacher / Administrator"];
  agentcore [label="Amazon Bedrock\nAgentCore Runtime", style="rounded,dashed"];

  supabase -> adapter [label=" progress + activity only"];
  adapter -> learner [label=" read-only sync"];
  platform -> api [label=" event + event_id"];
  api -> events;
  learner -> monitor;
  monitor -> watch [label=" scan / persist / clear"];
  events -> policy;
  watch -> policy;
  policy -> decisions;
  policy -> queue [label=" mandatory escalation"];
  queue -> triage;
  watch -> triage [label=" active risk"];
  decisions -> impact;
  monitor -> impact;
  queue -> impact;
  policy -> strands [label=" safe contextual case"];
  learner -> strands [label=" privacy-safe context"];
  triage -> strands [label=" fixed priority evidence"];
  impact -> strands [label=" non-causal evidence"];
  strands -> bedrock;
  strands -> tools;
  tools -> learner;
  triage -> dash;
  impact -> dash;
  decisions -> dash;
  watch -> dash;
  dash -> human;
  human -> queue [label=" resolve"];
  human -> impact [label=" resolution record"];
  agentcore -> strands [style=dashed, label=" same agent / safety path"];
}
