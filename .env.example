AWS_REGION=us-west-2
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
# policy = fully local deterministic demo; strands = Strands + Bedrock with policy fallback
COMMUNITY_AGENT_MODE=policy
COMMUNITY_AGENT_DB=data/community_agent.db

# Autonomous community scan (minimum 60 seconds)
MONITOR_ENABLED=true
MONITOR_INTERVAL_SECONDS=900

# Real Escola Lendária source. The project URL is public metadata; the service-role
# key is a secret and must NEVER be committed or pasted into issues/chats.
SUPABASE_URL=https://uvypcuixxrjikjaduvyo.supabase.co
SUPABASE_SECRET_KEY=
# Legacy fallback only (prefer SUPABASE_SECRET_KEY):
SUPABASE_SERVICE_ROLE_KEY=
# Turn on only in a trusted server/runtime after the secret has been injected.
SUPABASE_SYNC_ENABLED=false
